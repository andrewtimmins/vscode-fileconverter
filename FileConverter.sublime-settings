{
    // FileConverter: opens files matching a pattern by running them through
    // an external command and streaming its stdout into a new read-only
    // view, instead of loading the raw file as text.
    //
    // Commands are resolved via PATH by default (bare command names below),
    // so this settings file isn't tied to any one machine's install layout.
    // If a command name resolves to the wrong executable on your machine
    // (e.g. a PATH ordering conflict), override "decode_cmd"/"encode_cmd"
    // below with an absolute path, and/or use "env" to set any environment
    // variables the tool needs (e.g. to disable behaviour that's flaky when
    // the tool is invoked repeatedly in quick succession).

    // Environment variables merged into every handler's subprocess
    // environment (on top of the process environment). Per-handler "env"
    // below is merged on top of this.
    "env": {},

    "handlers": [
        {
            // RISC OS Module / Absolute / Utility binaries: disassemble with
            // riscos-dumpi and show the result as ARM assembly.
            "id": "riscos_module",
            "match": [
                ".*(\\\\|/)*,ff8$",
                ".*(\\\\|/)*,ffa$",
                ".*(\\\\|/)*,ffc$"
            ],
            // Note: deliberately no "--colour" -- dumpi's ANSI escape codes
            // would show as literal garbage in a plain view (Sublime views
            // don't interpret them); output_syntax below handles
            // highlighting instead.
            "decode_cmd": ["riscos-dumpi", "${file}"],
            "output_syntax": "Packages/ARM Assembly/Syntaxes/ARM Assembly.tmLanguage",
            "encode_cmd": null,
            "env": {}
        },
        {
            // RISC OS Draw files. Verified against the real tools:
            // riscos-decdrawf <file> writes a text representation to
            // stdout; riscos-mkdrawf <infile> <outfile> always appends
            // ",aff" to whatever outfile name it's given, hence
            // "encode_output_suffix" below so the plugin strips it before
            // invoking and renames the result to match the chosen
            // destination exactly. Round-tripped a real file byte-for-byte
            // identical except for a benign header field (the tool's own
            // "Creator" stamp).
            "id": "riscos_drawfile",
            "match": [".*(\\\\|/)*,aff$"],
            "decode_cmd": ["riscos-decdrawf", "${file}"],
            // decdrawf's brace-delimited text format happens to highlight
            // nicely with the (unrelated, but structurally similar)
            // Generic Config syntax.
            "output_syntax": "Packages/Generic Config/GenericConfig.sublime-syntax",
            "encode_cmd": ["riscos-mkdrawf", "${input}", "${output}"],
            "encode_output_suffix": ",aff",
            "env": {}
        },
        {
            // RISC OS Wimp Template (,fec) and Toolbox Resource (,fae)
            // files -- both handled by the same tool. Verified against the
            // real tool: riscos-ccres <infile> <outfile> has no stdout
            // mode of its own (always writes to a real output file), but
            // happily accepts "/dev/stdout" as that argument, so it can
            // still stream like the other handlers. It auto-detects both
            // the source filetype and the decode/encode direction from the
            // input file's content, so one command handles both formats
            // and both directions; writes exactly to the given output name
            // (no auto-appended suffix, unlike riscos-mkdrawf).
            // Round-tripped a real Template file: decode -> encode ->
            // decode again produced identical text (the binary itself
            // differs in size -- normal compiler-style repacking, not
            // corruption). Confirmed decoding a real Resource (,fae) file
            // too.
            "id": "riscos_ccres",
            "match": [".*(\\\\|/)*,fec$", ".*(\\\\|/)*,fae$"],
            "decode_cmd": ["riscos-ccres", "${file}", "/dev/stdout"],
            // ccres's brace-delimited text format highlights nicely with
            // Generic Config too, same as the drawfile handler above.
            "output_syntax": "Packages/Generic Config/GenericConfig.sublime-syntax",
            "encode_cmd": ["riscos-ccres", "${input}", "${output}"],
            "encode_output_suffix": "",
            "env": {}
        },
        {
            // RISC OS tokenised BASIC files. Verified against the real
            // tools: riscos-basicdetokenise takes its input via -i (not a
            // bare positional argument like the other tools) and writes to
            // stdout when -o is omitted; riscos-basictokenise <infile>
            // <outfile> writes exactly to the given output name (no
            // auto-appended suffix). Round-tripped a real file: decode ->
            // encode -> decode again produced identical text.
            // output_syntax points at the installed "BBC BASIC Syntax"
            // package (Packages/BBCBASIC, the loose dev copy of the same
            // package, is a broken symlink on this machine -- this uses
            // the separately-installed .sublime-package instead).
            "id": "riscos_basic",
            "match": [".*(\\\\|/)*,ffb$"],
            "decode_cmd": ["riscos-basicdetokenise", "-i", "${file}"],
            "output_syntax": "Packages/BBC BASIC Syntax/BBCBASIC.sublime-syntax",
            "encode_cmd": ["riscos-basictokenise", "${input}", "${output}"],
            "encode_output_suffix": "",
            "env": {}
        },
        {
            // Generic hex dump of any binary file. Not RISC OS specific --
            // included so the package is useful from the first install,
            // not just for RISC OS. Verified against a real binary file.
            "id": "hexdump",
            "match": [".*\\.bin$"],
            "decode_cmd": ["xxd", "${file}"],
            "output_syntax": null,
            "encode_cmd": null,
            "env": {}
        },
        {
            // Disassemble a compiled object file. Verified against a real
            // .o file. output_syntax is left null since the bundled
            // "NASM x86 Assembly" package is Intel-flavoured and would be
            // an imperfect match for objdump's AT&T-syntax output on some
            // platforms -- point it at whatever assembly syntax you have
            // installed, if any, and prefer it.
            "id": "objdump",
            "match": [".*\\.o$"],
            "decode_cmd": ["objdump", "-d", "${file}"],
            "output_syntax": null,
            "encode_cmd": null,
            "env": {}
        },
        {
            // Media file metadata. Verified against a real PNG.
            "id": "exif",
            "match": [".*\\.(jpg|jpeg|png|heic)$"],
            "decode_cmd": ["exiftool", "${file}"],
            "output_syntax": null,
            "encode_cmd": null,
            "env": {}
        }
    ]
}
