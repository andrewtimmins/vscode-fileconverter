[
    {
        "id": "file",
        "children":
        [
            { "caption": "-" },
            { "command": "file_converter_encode_buffer", "caption": "Re-encode As…" }
        ]
    },
    {
        "id": "preferences",
        "children":
        [
            {
                "id": "package-settings",
                "caption": "Package Settings",
                "children":
                [
                    {
                        "caption": "FileConverter",
                        "children":
                        [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args":
                                {
                                    "base_file": "${packages}/FileConverter/FileConverter.sublime-settings",
                                    "default": "// FileConverter Settings -- User\n{\n\t$0\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
